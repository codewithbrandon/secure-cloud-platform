// =============================================================================
// SECURE CI/CD PIPELINE — POLICY-ENFORCED DEVSECOPS
// =============================================================================
// Architecture: Security gate at every layer, fail-fast on any violation.
//
// NEW IN THIS VERSION — Terraform + Policy-as-Code enforcement layer:
//   Stage 6:  Terraform Init & Validate (fmt check, schema validation)
//   Stage 7:  Infrastructure Security Scan (Checkov + tfsec — parallel)
//   Stage 8:  Terraform Plan → JSON (saved for OPA evaluation)
//   Stage 9:  OPA / Conftest Policy Check (deny_public_ip, deny_open_nsg, require_tags)
//   Stage 15: Terraform Apply (main branch only, with manual approval gate)
//   Stage 16: Azure Post-Deploy Validation (validate_azure.sh)
//   BONUS:    Drift Detection job template at bottom of file
//
// Full Security Controls:
//   Secrets scan (gitleaks)        | SAST (Bandit)
//   Dependency scan (pip-audit)    | IaC scan (Checkov + tfsec)
//   Policy-as-Code (OPA/Conftest)  | Container scan (Trivy)
//   K8s manifest validation        | Post-deploy Azure validation
//   Supply chain (trusted ACR)     | Microsoft Sentinel integration
//
// Business Value:
//   Every commit is policy-evaluated before any cloud resource is touched.
//   Misconfiguration detected at plan time, not at incident response time.
//   Full audit trail: what changed, when, by whom, against which policy.
// =============================================================================

pipeline {
    agent any

    // =========================================================================
    // ENVIRONMENT VARIABLES
    // =========================================================================
    environment {
        // Azure Container Registry
        ACR_NAME         = 'acrseccloudprod'
        ACR_LOGIN_SERVER = "${ACR_NAME}.azurecr.io"
        IMAGE_NAME       = 'secure-api'

        // Kubernetes / AKS
        AKS_RESOURCE_GROUP = 'rg-seccloud-prod'
        AKS_CLUSTER_NAME   = 'aks-seccloud-prod'
        K8S_NAMESPACE      = 'secure-app'

        // Terraform workspace maps to environment
        // WHY: Separate workspaces = separate state files = blast radius isolation
        TF_WORKSPACE     = "${BRANCH_NAME == 'main' ? 'prod' : 'dev'}"
        TF_IN_AUTOMATION = 'true'

        // Image tag: 7-char git SHA + build number for traceability
        IMAGE_TAG = "${GIT_COMMIT.take(7)}-${BUILD_NUMBER}"

        // Scan thresholds
        TRIVY_SEVERITY = 'CRITICAL,HIGH'
        POLICY_DIR     = 'policies'
    }

    options {
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
        timestamps()
        ansiColor('xterm')
    }

    // =========================================================================
    // PIPELINE STAGES
    // =========================================================================
    stages {

        // =====================================================================
        // STAGE 1: CHECKOUT
        // =====================================================================
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_AUTHOR  = sh(script: 'git log -1 --pretty=format:"%an"', returnStdout: true).trim()
                    env.GIT_MESSAGE = sh(script: 'git log -1 --pretty=format:"%s"',  returnStdout: true).trim()
                }
                echo "Branch: ${BRANCH_NAME} | Commit: ${GIT_COMMIT} | Author: ${env.GIT_AUTHOR}"
            }
        }

        // =====================================================================
        // STAGE 2: SECRETS SCANNING (gitleaks)
        // WHY: Any credential committed to git — even for 1 minute — must be
        // rotated. Gitleaks catches API keys, tokens, and passwords at scan time.
        // MITRE T1552.001 Credentials in Files
        // =====================================================================
        stage('Secrets Scan') {
            steps {
                script {
                    def result = sh(
                        script: 'gitleaks detect --source . --no-git --verbose 2>&1 || true',
                        returnStatus: true
                    )
                    if (result != 0) {
                        error('SECURITY GATE: Secrets detected. Rotate any exposed credentials immediately.')
                    }
                }
                echo 'No secrets detected'
            }
        }

        // =====================================================================
        // STAGE 3: DEPENDENCY VULNERABILITY SCAN (pip-audit)
        // WHY: Transitive dependency CVEs are the #1 supply chain entry point.
        // pip-audit checks OSV and PyPI Security Advisories.
        // MITRE T1195.001 Compromise Software Dependencies
        // =====================================================================
        stage('Dependency Scan') {
            steps {
                dir('app') {
                    sh '''
                        python3 -m venv .venv
                        . .venv/bin/activate
                        pip install --quiet pip-audit
                        pip install --quiet -r requirements.txt
                        pip-audit --format json --output ../dependency-audit.json || true
                        pip-audit --format columns
                    '''
                }
                archiveArtifacts artifacts: 'dependency-audit.json', allowEmptyArchive: true
            }
        }

        // =====================================================================
        // STAGE 4: STATIC APPLICATION SECURITY TESTING (Bandit)
        // WHY: Catches hardcoded credentials, injection sinks, insecure crypto
        // before code runs anywhere.
        // CWE: CWE-78 OS Injection, CWE-89 SQL Injection, CWE-330 Weak Random
        // =====================================================================
        stage('SAST') {
            steps {
                dir('app') {
                    sh '''
                        . .venv/bin/activate
                        pip install --quiet bandit
                        bandit -r . -f json -o ../bandit-report.json -ll || true
                        bandit -r . -f txt -ll
                    '''
                }
                script {
                    def highCount = sh(
                        script: '''python3 -c "
import json, sys
with open('bandit-report.json') as f:
    r = json.load(f)
high = [x for x in r.get('results', []) if x['issue_severity'] == 'HIGH']
print(len(high))
"''',
                        returnStdout: true
                    ).trim().toInteger()
                    if (highCount > 0) {
                        error("SECURITY GATE: ${highCount} HIGH severity SAST findings. Fix before proceeding.")
                    }
                }
                archiveArtifacts artifacts: 'bandit-report.json', allowEmptyArchive: true
            }
        }

        // =====================================================================
        // STAGE 5: UNIT TESTS
        // =====================================================================
        stage('Unit Tests') {
            steps {
                dir('app') {
                    sh '''
                        . .venv/bin/activate
                        pip install --quiet pytest pytest-cov
                        pytest tests/ --cov=. --cov-report=xml --cov-report=html || true
                    '''
                }
            }
        }

        // =====================================================================
        // STAGE 6: TERRAFORM INIT & VALIDATE
        // WHY: init honours .terraform.lock.hcl — provider versions are pinned,
        // preventing silent upgrades that could change behaviour in production.
        // fmt -check enforces consistent style (free signal of code discipline).
        // =====================================================================
        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    withCredentials([
                        string(credentialsId: 'azure-client-id',      variable: 'ARM_CLIENT_ID'),
                        string(credentialsId: 'azure-tenant-id',       variable: 'ARM_TENANT_ID'),
                        string(credentialsId: 'azure-subscription-id', variable: 'ARM_SUBSCRIPTION_ID')
                    ]) {
                        sh '''
                            export ARM_USE_OIDC=true
                            terraform init \
                                -backend-config="resource_group_name=rg-terraform-state" \
                                -backend-config="storage_account_name=stterraformstate001" \
                                -backend-config="container_name=tfstate" \
                                -input=false \
                                -reconfigure
                            terraform fmt -check -recursive
                            terraform validate
                        '''
                        echo 'Terraform: init, fmt-check, and validate all passed'
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 7: INFRASTRUCTURE SECURITY SCANNING (Checkov + tfsec — parallel)
        // WHY: Two independent scanners with complementary rule sets:
        //   Checkov — NIST 800-53, CIS Benchmark, SOC 2 controls
        //   tfsec   — Azure provider-specific misconfigurations
        // Both fail on CRITICAL/HIGH. Medium issues produce warnings only.
        //
        // MITRE coverage: T1190 (public exposure), T1525 (ACR admin), T1552 (KV)
        // =====================================================================
        stage('Terraform Security Scan') {
            parallel {
                stage('Checkov') {
                    steps {
                        dir('terraform') {
                            script {
                                def result = sh(
                                    script: '''
                                        checkov -d . \
                                            --framework terraform \
                                            --output cli \
                                            --output json \
                                            --output-file-path ../checkov-report \
                                            --compact \
                                            --hard-fail-on CRITICAL,HIGH 2>&1
                                    ''',
                                    returnStatus: true
                                )
                                archiveArtifacts artifacts: '../checkov-report.json', allowEmptyArchive: true
                                if (result != 0) {
                                    error('SECURITY GATE: Checkov found CRITICAL/HIGH IaC misconfigurations. See checkov-report.json.')
                                }
                            }
                        }
                    }
                }
                stage('tfsec') {
                    steps {
                        dir('terraform') {
                            script {
                                def result = sh(
                                    script: '''
                                        tfsec . --minimum-severity HIGH --format sarif \
                                            --out ../tfsec-report.sarif --no-colour
                                        tfsec . --minimum-severity HIGH --no-colour
                                    ''',
                                    returnStatus: true
                                )
                                archiveArtifacts artifacts: '../tfsec-report.sarif', allowEmptyArchive: true
                                if (result != 0) {
                                    error('SECURITY GATE: tfsec found HIGH/CRITICAL IaC misconfigurations.')
                                }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 8: TERRAFORM PLAN
        // WHY: Binary plan saved to disk; OPA evaluates the JSON conversion.
        // Apply in Stage 15 uses the SAME binary plan — no TOCTOU race between
        // what was evaluated by OPA and what gets applied to Azure.
        // =====================================================================
        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    withCredentials([
                        string(credentialsId: 'azure-client-id',      variable: 'ARM_CLIENT_ID'),
                        string(credentialsId: 'azure-tenant-id',       variable: 'ARM_TENANT_ID'),
                        string(credentialsId: 'azure-subscription-id', variable: 'ARM_SUBSCRIPTION_ID')
                    ]) {
                        sh '''
                            export ARM_USE_OIDC=true
                            terraform workspace select ${TF_WORKSPACE} || terraform workspace new ${TF_WORKSPACE}
                            terraform plan -out=tfplan -input=false -var-file=terraform.tfvars
                            terraform show -json tfplan > tfplan.json
                        '''
                        archiveArtifacts artifacts: 'terraform/tfplan.json', allowEmptyArchive: true
                        echo 'Plan generated and serialised to JSON for OPA evaluation'
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 9: OPA / CONFTEST POLICY CHECK
        // WHY: Checkov/tfsec scan static Terraform source. OPA evaluates the
        // ACTUAL plan — what will be created at runtime. Catches:
        //   - Dynamic values resolved only at plan time (computed attributes)
        //   - Resource combinations that are individually OK but dangerous together
        //   - Governance: tagging, approved regions, naming conventions
        //
        // Policies:
        //   deny_public_ip.rego   No public IPs on non-boundary resources
        //   deny_open_nsg.rego    No 0.0.0.0/0 on management ports
        //   require_tags.rego     All resources need 6 mandatory tags
        //   kubernetes.rego       Container security baseline for K8s manifests
        // =====================================================================
        stage('OPA Policy Check') {
            steps {
                script {
                    def tfResult = sh(
                        script: '''
                            conftest test terraform/tfplan.json \
                                --policy ${POLICY_DIR} \
                                --namespace terraform.deny_public_ip \
                                --namespace terraform.deny_open_nsg \
                                --namespace terraform.require_tags \
                                --output table --no-color
                        ''',
                        returnStatus: true
                    )
                    def k8sResult = sh(
                        script: 'conftest test k8s/*.yaml --policy ${POLICY_DIR} --output table --no-color',
                        returnStatus: true
                    )
                    if (tfResult != 0) {
                        error('POLICY GATE: Terraform plan violates infrastructure policy. Review OPA output.')
                    }
                    if (k8sResult != 0) {
                        error('POLICY GATE: K8s manifests violate container security policy.')
                    }
                }
                echo 'All OPA/Conftest policy checks passed'
            }
        }

        // =====================================================================
        // STAGE 10: BUILD CONTAINER IMAGE
        // WHY: --pull ensures base image is the latest digest (no stale cache
        // with unpatched CVEs). BuildKit enables cache mounts and build secrets
        // that do not leak into image layers.
        // =====================================================================
        stage('Build Image') {
            steps {
                dir('app') {
                    sh """
                        DOCKER_BUILDKIT=1 docker build \
                            --no-cache --pull \
                            --label org.opencontainers.image.revision=${GIT_COMMIT} \
                            --label org.opencontainers.image.created=\$(date -u +%Y-%m-%dT%H:%M:%SZ) \
                            --label build.number=${BUILD_NUMBER} \
                            -t ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:latest \
                            .
                    """
                }
            }
        }

        // =====================================================================
        // STAGE 11: CONTAINER IMAGE SCAN (Trivy)
        // WHY: Even a correctly written Dockerfile can pull a base image with
        // known CVEs. Trivy blocks deployment of vulnerable images.
        // MITRE T1525 Implant Internal Image
        // =====================================================================
        stage('Image Scan') {
            steps {
                script {
                    def result = sh(
                        script: """
                            trivy image --severity ${TRIVY_SEVERITY} --exit-code 1 \
                                --no-progress --format sarif --output trivy-report.sarif \
                                ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:${IMAGE_TAG}
                        """,
                        returnStatus: true
                    )
                    archiveArtifacts artifacts: 'trivy-report.sarif', allowEmptyArchive: true
                    if (result != 0) {
                        error("SECURITY GATE: Trivy found ${TRIVY_SEVERITY} vulnerabilities in image.")
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 12: PUSH TO ACR
        // WHY: Image pushed ONLY after all scans pass. ACR is the sole trusted
        // registry — images from any other source are blocked at admission.
        // =====================================================================
        stage('Push to ACR') {
            steps {
                sh """
                    az login --identity
                    az acr login --name ${ACR_NAME}
                    docker push ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:latest
                """
            }
        }

        // =====================================================================
        // STAGE 13 & 14: VALIDATE K8s + MONITORING MANIFESTS
        // =====================================================================
        stage('Validate K8s Manifests') {
            steps {
                sh 'for f in k8s/*.yaml; do kubeval --strict --ignore-missing-schemas "$f" && echo "OK: $f"; done'
            }
        }

        stage('Validate Monitoring Configs') {
            steps {
                sh 'for f in monitoring/*.yaml; do kubeval --strict --ignore-missing-schemas "$f" && echo "OK: $f"; done'
            }
        }

        // =====================================================================
        // STAGE 15: TERRAFORM APPLY
        // WHY: apply uses the EXACT binary plan from Stage 8 — guarantees OPA
        // evaluated exactly what gets applied. Manual approval gate captures a
        // JIRA ticket for audit trail. Every change has a documented reason.
        // =====================================================================
        stage('Terraform Apply') {
            when { branch 'main' }
            input {
                message "Apply Terraform changes to production?"
                ok "Apply"
                parameters {
                    string(name: 'REASON', defaultValue: '', description: 'Change reason / JIRA ticket')
                }
            }
            steps {
                dir('terraform') {
                    withCredentials([
                        string(credentialsId: 'azure-client-id',      variable: 'ARM_CLIENT_ID'),
                        string(credentialsId: 'azure-tenant-id',       variable: 'ARM_TENANT_ID'),
                        string(credentialsId: 'azure-subscription-id', variable: 'ARM_SUBSCRIPTION_ID')
                    ]) {
                        sh '''
                            export ARM_USE_OIDC=true
                            echo "Applying plan. Reason: ${REASON}"
                            terraform apply -input=false -auto-approve tfplan
                        '''
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 16: AZURE POST-DEPLOY VALIDATION
        // WHY: Verifies live Azure state matches security intent. Catches:
        //   - Terraform provider bugs (resource created in insecure state)
        //   - Manual portal changes made between pipeline runs
        //   - Race conditions during resource provisioning
        //
        // Validates: private cluster, RBAC, no public node IPs, NSG rules,
        //            ACR admin disabled, AcrPull role, diagnostic logs enabled
        // Fails the pipeline — AKS deployment does NOT proceed if this fails.
        // =====================================================================
        stage('Azure Post-Deploy Validation') {
            when { branch 'main' }
            steps {
                script {
                    def result = sh(
                        script: """
                            export RESOURCE_GROUP=${AKS_RESOURCE_GROUP}
                            export AKS_CLUSTER_NAME=${AKS_CLUSTER_NAME}
                            export ACR_NAME=${ACR_NAME}
                            chmod +x validation/validate_azure.sh
                            ./validation/validate_azure.sh
                        """,
                        returnStatus: true
                    )
                    if (result != 0) {
                        error('POST-DEPLOY GATE: Azure infrastructure validation failed. Deployment blocked.')
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 17: DEPLOY TO AKS
        // WHY: Runs AFTER infrastructure validation. If the cluster is mis-
        // configured, we block here — workloads never land on unsafe nodes.
        // =====================================================================
        stage('Deploy to AKS') {
            when { branch 'main' }
            steps {
                sh """
                    az aks get-credentials \
                        --resource-group ${AKS_RESOURCE_GROUP} \
                        --name ${AKS_CLUSTER_NAME} \
                        --overwrite-existing

                    kubectl apply -f k8s/namespace.yaml
                    kubectl apply -f k8s/serviceaccount.yaml
                    kubectl apply -f k8s/networkpolicy.yaml
                    kubectl apply -f k8s/service.yaml

                    sed -i 's|\\\${ACR_NAME}|${ACR_NAME}|g'   k8s/deployment.yaml
                    sed -i 's|\\\${IMAGE_TAG}|${IMAGE_TAG}|g' k8s/deployment.yaml
                    kubectl apply -f k8s/deployment.yaml
                    kubectl apply -f k8s/hpa.yaml

                    kubectl rollout status deployment/secure-api \
                        -n ${K8S_NAMESPACE} --timeout=300s
                """
            }
        }

        // =====================================================================
        // STAGE 18: DEPLOY MONITORING STACK
        // =====================================================================
        stage('Deploy Monitoring') {
            when { branch 'main' }
            steps {
                sh '''
                    kubectl apply -f monitoring/monitoring-namespace.yaml
                    kubectl apply -f monitoring/monitoring-pvc.yaml
                    kubectl apply -f monitoring/alertmanager-config.yaml
                    kubectl apply -f monitoring/alertmanager-deployment.yaml
                    kubectl apply -f monitoring/kube-state-metrics.yaml
                    kubectl apply -f monitoring/node-exporter.yaml
                    kubectl apply -f monitoring/grafana-provisioning.yaml
                    kubectl apply -f monitoring/grafana-security-dashboard.yaml
                    kubectl apply -f monitoring/prometheus-config.yaml
                    kubectl apply -f monitoring/prometheus-deployment.yaml
                    kubectl apply -f monitoring/grafana-deployment.yaml
                    kubectl apply -f monitoring/monitoring-networkpolicy.yaml
                    kubectl rollout status deployment/prometheus   -n monitoring --timeout=180s
                    kubectl rollout status deployment/grafana      -n monitoring --timeout=180s
                    kubectl rollout status deployment/alertmanager -n monitoring --timeout=120s
                '''
            }
        }

        // =====================================================================
        // STAGE 19: SMOKE TESTS
        // =====================================================================
        stage('Smoke Tests') {
            when { branch 'main' }
            steps {
                sh """
                    sleep 20
                    SERVICE_IP=\$(kubectl get svc secure-api -n ${K8S_NAMESPACE} \
                        -o jsonpath='{.spec.clusterIP}')
                    kubectl run smoke-test --image=curlimages/curl \
                        --restart=Never --rm -i \
                        -- curl -sf http://\${SERVICE_IP}/health
                    echo "Smoke test passed: HTTP 200 from /health"
                """
            }
        }

    } // end stages

    // =========================================================================
    // POST ACTIONS
    // =========================================================================
    post {
        always {
            archiveArtifacts artifacts: [
                '**/trivy-report.sarif',
                '**/bandit-report.json',
                '**/dependency-audit.json',
                '**/checkov-report.json',
                '**/tfsec-report.sarif',
                '**/terraform/tfplan.json'
            ].join(','), allowEmptyArchive: true
            sh """
                docker rmi ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:${IMAGE_TAG} || true
                docker rmi ${ACR_LOGIN_SERVER}/${IMAGE_NAME}:latest || true
            """
            cleanWs()
        }
        success {
            echo "Pipeline passed: ${BRANCH_NAME} @ ${GIT_COMMIT} by ${env.GIT_AUTHOR}"
            // slackSend channel: '#deployments', color: 'good',
            //   message: "Deploy success: ${JOB_NAME} #${BUILD_NUMBER} (${env.GIT_AUTHOR})"
        }
        failure {
            echo "Pipeline FAILED: ${BRANCH_NAME} @ ${GIT_COMMIT}"
            // slackSend channel: '#security-pipeline', color: 'danger',
            //   message: "FAILED: ${JOB_NAME} #${BUILD_NUMBER} -- ${env.GIT_AUTHOR}"
        }
    }
}

// =============================================================================
// DRIFT DETECTION JOB — Configure as a SEPARATE Jenkins pipeline
// =============================================================================
// Purpose: Detect when production infrastructure diverges from Terraform state.
// Common causes: portal emergency changes, Azure platform updates, compromised
// accounts modifying resources directly (MITRE T1578).
//
// A drifted resource is an unreviewed resource — a compliance finding.
// Daily drift detection ensures "the last known good state" is recent.
//
// Setup: Jenkins > New Item > Pipeline > paste below > Schedule: H 6 * * *
//
// pipeline {
//     agent any
//     triggers { cron('H 6 * * *') }
//     environment { TF_IN_AUTOMATION = 'true' }
//     stages {
//         stage('Drift Check') {
//             steps {
//                 dir('terraform') {
//                     withCredentials([
//                         string(credentialsId: 'azure-client-id',      variable: 'ARM_CLIENT_ID'),
//                         string(credentialsId: 'azure-tenant-id',       variable: 'ARM_TENANT_ID'),
//                         string(credentialsId: 'azure-subscription-id', variable: 'ARM_SUBSCRIPTION_ID')
//                     ]) {
//                         script {
//                             sh 'export ARM_USE_OIDC=true && terraform init -input=false && terraform workspace select prod'
//                             // -detailed-exitcode: 0=no changes, 1=error, 2=drift
//                             def rc = sh(
//                                 script: 'export ARM_USE_OIDC=true && terraform plan -detailed-exitcode -input=false -var-file=terraform.tfvars 2>&1 | tee drift-report.txt',
//                                 returnStatus: true
//                             )
//                             archiveArtifacts artifacts: 'drift-report.txt'
//                             if (rc == 1) { error('Terraform plan failed -- check state/provider errors') }
//                             if (rc == 2) {
//                                 currentBuild.result = 'UNSTABLE'
//                                 echo 'DRIFT DETECTED: Production diverges from Terraform. Re-apply or update code.'
//                                 // slackSend channel: '#security-ops', color: 'warning',
//                                 //   message: 'DRIFT ALERT: Production infra != Terraform. See drift-report.txt.'
//                             } else {
//                                 echo 'No drift -- production infrastructure matches Terraform state.'
//                             }
//                         }
//                     }
//                 }
//             }
//         }
//     }
// }
// =============================================================================
